{
  "version": "revenue-tides-design-1.0.0-candidate",
  "concept": "TIDAL_LEDGER",
  "colors": {
    "background": "#F3F0E7",
    "surface": "#FBF9F2",
    "surface_secondary": "#E8E3D6",
    "text_primary": "#192321",
    "text_secondary": "#4B5753",
    "border": "#969B92",
    "grid": "#C9C7BC",
    "accent_primary": "#1F6763",
    "accent_secondary": "#864B32",
    "event": "#864B32",
    "uncertainty": "#59615E",
    "direct_evidence": "#1F6763",
    "derived_evidence": "#655B75",
    "focus": "#005FCC",
    "warning": "#7A4618"
  },
  "contrast_targets": {
    "body_text": "WCAG 2.2 AA, at least 4.5:1",
    "large_text": "WCAG 2.2 AA, at least 3:1",
    "focus_indicator": "at least 3:1 against adjacent colors",
    "non_text_marks": "at least 3:1 where the mark conveys meaning"
  },
  "typography": {
    "sans_stack": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif",
    "numeric_stack": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace",
    "weights": [400, 500, 650],
    "line_heights": {
      "compact": 1.2,
      "body": 1.55,
      "reading": 1.7
    },
    "scale_px": {
      "annotation": 12,
      "body_small": 14,
      "body": 16,
      "finding_title": 24,
      "section_title": 32,
      "display": 52
    },
    "tabular_numerals_required": true
  },
  "spacing_px": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "rules_px": {
    "hairline": 1,
    "emphasis": 2,
    "version_break": 4
  },
  "radius_px": {
    "none": 0,
    "small": 2,
    "control": 4
  },
  "motion_ms": {
    "micro_min": 120,
    "micro_max": 200,
    "structural_min": 250,
    "structural_max": 450,
    "signature_min": 350,
    "signature_max": 650
  },
  "breakpoints_px": {
    "wide": 1440,
    "desktop": 1280,
    "compact_desktop": 1024,
    "tablet": 768,
    "mobile": 390,
    "survival": 320
  },
  "touch_target_px": 44,
  "content_max_widths_px": {
    "reading": 720,
    "narrative": 1180,
    "analytical_canvas": 1280
  },
  "chart_annotation_px": {
    "minimum": 12,
    "default": 13,
    "important": 15
  },
  "encoding_policy": {
    "direct": "solid mark plus DIRECT label",
    "derived": "outlined diamond plus interval and DERIVED label",
    "uncertainty": "whisker or hatched span; never opacity alone",
    "event": "separate copper context rail with neutral tick and event label",
    "version_break": "double calibration seam plus label; never color alone"
  }
}
